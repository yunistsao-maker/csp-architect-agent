<mxfile host="drawio"><diagram id="net" name="1. Network and security path"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="net-title" value="&lt;b style='font-size:18px'&gt;Portal agents on AgentCore: on-prem portal (corporate SSO) → Direct Connect → Transit Gateway → PrivateLink → AgentCore Gateway → 4 AgentCore Runtimes&lt;/b&gt;&lt;br&gt;JWT is validated once at the gateway edge; every hop after that is IAM (SigV4). No internet path from on-prem or from the agent VPC. Sessions in DynamoDB and uploads in S3 expire after 90 days. Terraform / documents become pull requests in the internal Git." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2380" height="64" as="geometry"/></mxCell><mxCell id="net-onprem" value="Corporate data center (on-prem)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;fontColor=#5A6B86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="440" height="1250" as="geometry"/></mxCell><mxCell id="net-users" value="Employees (browser)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" vertex="1" parent="net-onprem"><mxGeometry x="60" y="50" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-idp" value="Corporate SSO IdP&lt;br&gt;(OIDC: Entra ID / Okta / ADFS)&lt;br&gt;&lt;i&gt;not federated to IAM&lt;/i&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="net-onprem"><mxGeometry x="300" y="50" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-portal" value="On-prem portal&lt;br&gt;4 agents · uploads ·&lt;br&gt;sessions · job polling" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="net-onprem"><mxGeometry x="60" y="250" width="44" height="56" as="geometry"/></mxCell><mxCell id="net-dns" value="Corporate DNS&lt;br&gt;conditional forwarders:&lt;br&gt;*.gateway.bedrock-agentcore.REGION…&lt;br&gt;s3.REGION.amazonaws.com" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="net-onprem"><mxGeometry x="300" y="250" width="44" height="56" as="geometry"/></mxCell><mxCell id="net-fw" value="Egress firewall&lt;br&gt;443 → endpoint IPs&lt;br&gt;53 → Resolver IPs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.generic_firewall;" vertex="1" parent="net-onprem"><mxGeometry x="60" y="454" width="56" height="48" as="geometry"/></mxCell><mxCell id="net-router" value="Customer edge routers ×2&lt;br&gt;(BGP, MACsec)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.customer_gateway;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="net-onprem"><mxGeometry x="300" y="450" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-git" value="Internal Git (GitLab / GHE)&lt;br&gt;infra-live · design-reviews · use-cases&lt;br&gt;MR + CI (fmt / validate / plan)&lt;br&gt;+ human approval" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="net-onprem"><mxGeometry x="300" y="670" width="44" height="56" as="geometry"/></mxCell><mxCell id="net-jwt" value="&lt;b&gt;JWT the portal backend sends&lt;/b&gt;&lt;br&gt;• iss = corporate IdP · aud / client_id = portal app&lt;br&gt;• preferred_username / upn = &lt;b&gt;yhtsao&lt;/b&gt; → alias&lt;br&gt;• exp ≤ 60 min, RS256 (IdP JWKS)&lt;br&gt;&lt;br&gt;&lt;b&gt;Every agent call is short&lt;/b&gt; (15-min gateway limit)&lt;br&gt;generate → {job_id} · status every 15 s · publish → PR" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#EEF4FF;strokeColor=#1A73E8;fontColor=#1F2937;" vertex="1" parent="net-onprem"><mxGeometry x="30" y="830" width="380" height="160" as="geometry"/></mxCell><mxCell id="net-jwks" value="&lt;b&gt;⚠ JWKS reachability&lt;/b&gt;&lt;br&gt;The gateway fetches the IdP's OIDC discovery document and JWKS over the internet, from the AWS side. An internal-only IdP must publish them (WAP / reverse proxy) or federate through a cloud IdP / Cognito." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF7E6;strokeColor=#D97706;fontColor=#1F2937;" vertex="1" parent="net-onprem"><mxGeometry x="30" y="1010" width="380" height="110" as="geometry"/></mxCell><mxCell id="net-dx" value="AWS Direct Connect&lt;br&gt;2 connections × 2 locations&lt;br&gt;(maximum resiliency)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="1"><mxGeometry x="567" y="540" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-internet" value="Internet&lt;br&gt;(IdP discovery / JWKS only)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_alt1;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="64" height="40" as="geometry"/></mxCell><mxCell id="net-cloud" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="730" y="90" width="1680" height="1250" as="geometry"/></mxCell><mxCell id="net-dxgw" value="Direct Connect&lt;br&gt;gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="net-cloud"><mxGeometry x="45" y="450" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-region" value="AWS Region (us-east-1 for the web-search connector)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#007F80;dashed=1;" vertex="1" parent="net-cloud"><mxGeometry x="150" y="40" width="1520" height="1190" as="geometry"/></mxCell><mxCell id="net-tgw" value="Transit Gateway&lt;br&gt;RT: on-prem CIDR&lt;br&gt;↔ agent VPC" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="net-region"><mxGeometry x="40" y="410" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpc" value="Agent VPC · no IGW · no NAT" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="net-region"><mxGeometry x="200" y="50" width="620" height="1120" as="geometry"/></mxCell><mxCell id="net-sub" value="Private subnets · AZ-a + AZ-b" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;grIcon=mxgraph.aws4.group_security_group;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#147EBA;dashed=0;" vertex="1" parent="net-vpc"><mxGeometry x="20" y="40" width="580" height="1060" as="geometry"/></mxCell><mxCell id="net-r53" value="Route 53 Resolver&lt;br&gt;inbound endpoint" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53_resolver;" vertex="1" parent="net-sub"><mxGeometry x="50" y="70" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpce_logs" value="Interface endpoint&lt;br&gt;&lt;b&gt;logs&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="net-sub"><mxGeometry x="240" y="70" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpce_sm" value="Interface endpoint&lt;br&gt;&lt;b&gt;secretsmanager&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="net-sub"><mxGeometry x="430" y="70" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-tgwa" value="TGW attachment" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.transit_gateway_attachment;" vertex="1" parent="net-sub"><mxGeometry x="50" y="320" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpce_gw" value="Interface endpoint&lt;br&gt;&lt;b&gt;bedrock-agentcore.gateway&lt;/b&gt;&lt;br&gt;policy: ingress + tools gateways&lt;br&gt;SG 443: VPC + on-prem CIDR" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="net-sub"><mxGeometry x="240" y="320" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-eni" value="AgentCore Runtime ENIs ×4&lt;br&gt;(VPC network mode)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.elastic_network_interface;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="net-sub"><mxGeometry x="50" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpce_s3if" value="Interface endpoint &lt;b&gt;s3&lt;/b&gt;&lt;br&gt;on-prem uploads (presigned PUT)&lt;br&gt;private DNS: inbound Resolver only" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="net-sub"><mxGeometry x="430" y="490" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpce_br" value="Interface endpoint&lt;br&gt;&lt;b&gt;bedrock-runtime&lt;/b&gt;&lt;br&gt;policy: approved Claude models" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="net-sub"><mxGeometry x="240" y="660" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-geni" value="git-pr Lambda ENIs&lt;br&gt;SG 443 → Git CIDR + VPC" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.elastic_network_interface;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="net-sub"><mxGeometry x="430" y="660" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpce_ddb" value="Gateway endpoint&lt;br&gt;&lt;b&gt;dynamodb&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoint;" vertex="1" parent="net-sub"><mxGeometry x="50" y="820" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpce_s3" value="Gateway endpoint &lt;b&gt;s3&lt;/b&gt;&lt;br&gt;(route tables)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoint;" vertex="1" parent="net-sub"><mxGeometry x="240" y="820" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-vpce_note" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoint;" vertex="1" parent="net-sub"><mxGeometry x="430" y="820" width="1" height="1" as="geometry"/></mxCell><mxCell id="net-managed" value="AWS-managed (regional): reached via PrivateLink or service-side IAM" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;strokeColor=#01A88D;fillColor=#F2FBF9;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#016B5A;fontStyle=1;fontSize=12;container=1;collapsible=0;" vertex="1" parent="net-region"><mxGeometry x="840" y="50" width="670" height="1120" as="geometry"/></mxCell><mxCell id="net-cwl" value="CloudWatch Logs&lt;br&gt;(alias in every line)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.logs;" vertex="1" parent="net-managed"><mxGeometry x="50" y="110" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-icpt" value="Interceptor Lambda&lt;br&gt;ingress: JWT claim → alias header&lt;br&gt;tools: tool ACL per agent kind" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="net-managed"><mxGeometry x="290" y="110" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-sm" value="Secrets Manager&lt;br&gt;(Git bot token)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="net-managed"><mxGeometry x="530" y="110" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-ingw" value="AgentCore Gateway &lt;b&gt;csp-arch-ingress&lt;/b&gt;&lt;br&gt;CUSTOM_JWT (corporate IdP)&lt;br&gt;4 targets · aws:SourceVpce" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="net-managed"><mxGeometry x="50" y="360" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-rt" value="AgentCore Runtimes ×4&lt;br&gt;csp-architect · coe-doc&lt;br&gt;aicoe-doc · terraform&lt;br&gt;policy: ingress role only" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="net-managed"><mxGeometry x="290" y="360" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-web" value="Web-search connector&lt;br&gt;(egress on the AWS side)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.globe;" vertex="1" parent="net-managed"><mxGeometry x="50" y="530" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-tools" value="AgentCore Gateway &lt;b&gt;csp-arch-tools&lt;/b&gt;&lt;br&gt;MCP · AWS_IAM" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="net-managed"><mxGeometry x="290" y="530" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-bedrock" value="Amazon Bedrock&lt;br&gt;Claude" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="net-managed"><mxGeometry x="50" y="700" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-hook" value="Post-processing hook&lt;br&gt;Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="net-managed"><mxGeometry x="290" y="700" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-gitfn" value="git-pr&lt;br&gt;Lambda&lt;br&gt;(VPC)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" vertex="1" parent="net-managed"><mxGeometry x="530" y="700" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-s3" value="S3 buckets&lt;br&gt;artifacts: diagrams/ · jobs/ (7 d)&lt;br&gt;uploads: uploads/ · sessions/ (90 d)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="net-managed"><mxGeometry x="50" y="860" width="56" height="58" as="geometry"/></mxCell><mxCell id="net-ddb" value="DynamoDB sessions&lt;br&gt;PK alias#session · TTL 90 d&lt;br&gt;lock lease per session" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="net-managed"><mxGeometry x="50" y="1000" width="56" height="56" as="geometry"/></mxCell><mxCell id="net-lg" value="&lt;b&gt;Lines&lt;/b&gt; &amp;nbsp; &lt;font color='#1A73E8'&gt;━ user path (JWT) ┅ uploads&lt;/font&gt; &amp;nbsp; &lt;font color='#2E7D32'&gt;━ IAM SigV4&lt;/font&gt; &amp;nbsp; &lt;font color='#7B1FA2'&gt;━ S3&lt;/font&gt; &amp;nbsp; &lt;font color='#C925D1'&gt;━ DynamoDB&lt;/font&gt; &amp;nbsp; &lt;font color='#C2410C'&gt;━ Git (PR)&lt;/font&gt; &amp;nbsp; &lt;font color='#6B7280'&gt;┅ DNS / JWKS / ENI placement&lt;/font&gt; &amp;nbsp; &lt;font color='#E7157B'&gt;┅ logs&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=none;strokeColor=none;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="20" y="1350" width="1600" height="30" as="geometry"/></mxCell><mxCell id="net-steps" value="① Sign in to the portal with corporate SSO. ② The portal gets a JWT (not federated to IAM). ③ Corporate DNS forwards the gateway and S3 names to the Route 53 inbound endpoint. ③b Files are uploaded with a presigned PUT to the S3 interface endpoint. ④ The portal backend calls /&amp;lt;agent&amp;gt;/invocations with the JWT over DX → TGW. ⑤ PrivateLink to the ingress gateway, which validates the JWT; ⑥ the interceptor puts the alias in a header. ⑦ The gateway invokes the agent's runtime with its IAM role and gets a job_id. ⑧ The agent calls Claude, ⑨ the tools gateway, ⑩ its DynamoDB session and ⑪ S3, all through VPC endpoints. ⑫ Publishing calls the git-pr Lambda, which ⑬ opens a merge request in the internal Git over TGW → DX." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="20" y="1385" width="2380" height="70" as="geometry"/></mxCell><mxCell id="net-controls" value="&lt;b&gt;Controls&lt;/b&gt; · JWT only at the edge, SigV4 inside · runtime resource policies: ingress role only · tool ACL per agent kind (TOOL_ACL) · git-pr profiles: repo + path prefix + file types per agent · jobs, sessions and uploads readable only by their alias · no IGW / NAT · endpoint policies · uploads bucket accepts PUT only via its endpoint · sessions (DynamoDB TTL) and uploads (S3 lifecycle) deleted after 90 days" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#F0FDF4;strokeColor=#2E7D32;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="20" y="1465" width="2380" height="50" as="geometry"/></mxCell><mxCell id="net-e1" value="① HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontSize=10;fontColor=#1A73E8;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="net-users" target="net-portal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="net-e2" value="② OIDC sign-in → JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontSize=10;fontColor=#1A73E8;fontStyle=1;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="net-portal" target="net-idp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="354"/><mxPoint x="265" y="168"/></Array></mxGeometry></mxCell><mxCell id="net-e3" value="③ resolve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#6B7280;fontSize=10;fontColor=#6B7280;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="net-portal" target="net-dns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="net-e3b" value="③ DNS forward (53) over DX"