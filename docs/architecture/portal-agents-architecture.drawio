try x="1880" y="450" width="56" height="56" as="geometry"/></mxCell><mxCell id="agents-gitpr" value="git-pr Lambda&lt;br&gt;profile per agent kind" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1880" y="600" width="56" height="56" as="geometry"/></mxCell><mxCell id="agents-acl" value="&lt;b&gt;Tool ACL&lt;/b&gt; (x-agent-kind)&lt;br&gt;csp-architect: web search, hook&lt;br&gt;coe / aicoe: git-pr&lt;br&gt;terraform: web search, git-pr" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1640" y="90" width="200" height="80" as="geometry"/></mxCell><mxCell id="agents-gitg" value="Internal Git (on-prem, via TGW → DX)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;strokeColor=#C2410C;fillColor=#FFF7ED;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#C2410C;fontStyle=1;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1640" y="900" width="440" height="270" as="geometry"/></mxCell><mxCell id="agents-r_tf" value="&lt;b&gt;platform/infra-live&lt;/b&gt;&lt;br&gt;terraform/&amp;lt;name&amp;gt;/** · .tf .md" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#C2410C;fontColor=#1F2937;" vertex="1" parent="agents-gitg"><mxGeometry x="20" y="40" width="200" height="70" as="geometry"/></mxCell><mxCell id="agents-r_coe" value="&lt;b&gt;ccoe/design-reviews&lt;/b&gt;&lt;br&gt;docs/coe/** · .md" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#C2410C;fontColor=#1F2937;" vertex="1" parent="agents-gitg"><mxGeometry x="20" y="120" width="200" height="60" as="geometry"/></mxCell><mxCell id="agents-r_ai" value="&lt;b&gt;aicoe/use-cases&lt;/b&gt;&lt;br&gt;docs/aicoe/** · .md" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#C2410C;fontColor=#1F2937;" vertex="1" parent="agents-gitg"><mxGeometry x="20" y="190" width="200" height="60" as="geometry"/></mxCell><mxCell id="agents-r_ci" value="&lt;b&gt;Merge request&lt;/b&gt;&lt;br&gt;branch agent/&amp;lt;kind&amp;gt;/&amp;lt;alias&amp;gt;/&amp;lt;job&amp;gt;&lt;br&gt;Requested-by: alias&lt;br&gt;CI: terraform fmt / validate / plan&lt;br&gt;human review + approval" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#C2410C;fontColor=#1F2937;" vertex="1" parent="agents-gitg"><mxGeometry x="230" y="40" width="195" height="210" as="geometry"/></mxCell><mxCell id="agents-seq" value="&lt;b&gt;One request, end to end&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;upload_url&lt;/b&gt; {filename, content_type, size} → presigned PUT (5 min, exact type and size) → PUT over DX to the S3 interface endpoint&lt;br&gt;2. &lt;b&gt;generate&lt;/b&gt; {prompt, mode, doc_type, attachments, session_id} → {job_id} in ~1 s (session locked)&lt;br&gt;3. &lt;b&gt;status&lt;/b&gt; every 15 s → RUNNING … SUCCEEDED with document / review / files + checks (or FAILED / LOST)&lt;br&gt;4. the next turn in the same session_id refines the same draft (history restored from DynamoDB on any microVM)&lt;br&gt;5. &lt;b&gt;publish&lt;/b&gt; {job_id} → only if checks passed → git-pr → merge request (idempotent: one job, one MR)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1580" height="110" as="geometry"/></mxCell><mxCell id="agents-ret" value="&lt;b&gt;Retention&lt;/b&gt; · DynamoDB sessions: TTL 90 days from creation · S3 uploads/ and sessions/: lifecycle 90 days · jobs/: 7 days · diagrams/: kept (artifact bucket) · Git: permanent, reviewed" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#F5F3FF;strokeColor=#C925D1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="1580" height="40" as="geometry"/></mxCell><mxCell id="agents-g_a_csp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=10;fontColor=#2E7D32;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-ingw" target="agents-a_csp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agents-g_a_coe" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=10;fontColor=#2E7D32;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-ingw" target="agents-a_coe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agents-g_a_aicoe" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=10;fontColor=#2E7D32;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-ingw" target="agents-a_aicoe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agents-g_a_tf" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=10;fontColor=#2E7D32;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-ingw" target="agents-a_tf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agents-p_gw" value="JWT · job_id · status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontSize=10;fontColor=#1A73E8;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-tab_coe" target="agents-ingw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agents-csp_tf" value="architecture_job_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7B1FA2;fontSize=10;fontColor=#7B1FA2;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-a_csp" target="agents-a_tf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="216"/><mxPoint x="1135" y="726"/></Array></mxGeometry></mxCell><mxCell id="agents-sh1" value="every agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#01A88D;fontSize=10;fontColor=#01A88D;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.32;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-agents" target="agents-shared"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="agents-t1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=10;fontColor=#2E7D32;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agents-tools" target="agents-web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mx